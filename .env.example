# MongoDB Configuration (REQUIRED)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0

# EVM Configuration - Ethereum Sepolia Testnet (REQUIRED)
EVM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
EVM_WS_RPC_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
EVM_CONFIRMATION_BLOCKS=1
STATIC_WALLET_ADDRESS=0xYourVaultAddress

# Node Environment (REQUIRED)
NODE_ENV=production

# Alchemy Webhook for Event Monitoring
ALCHEMY_WEBHOOK_TOKEN=your_webhook_token

# Canton Configuration
CANTON_GRPC_ENDPOINT=localhost:5011
CANTON_PARTICIPANT_ID=participant1
CANTON_PARTY_ID=your_party_id
CANTON_TOKEN_CONTRACT_ID=your_token_contract_id

# Hot Wallet Private Key (keep secure in production)
HOT_WALLET_PRIVATE_KEY=0x...

# Master HD Wallet Seed (for deposit address generation)
MASTER_SEED_PHRASE=your_bip39_seed_phrase

# Logging
LOG_LEVEL=info
